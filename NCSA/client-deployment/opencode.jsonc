{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["ncsahosted"],
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
  },
  "mode": {
    "support": {
      "model": "ncsahosted/Qwen/Qwen3.6-27B",
      "prompt": "{file:./prompts/support.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "ask": {
      "model": "ncsahosted/Qwen/Qwen3.6-27B",
      "prompt": "{file:./prompts/ask.txt}",
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "write": false,
        "edit": false,
        "bash": true
      },
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": {
          "squeue *": "allow",
          "sacct *": "allow",
          "scontrol show job *": "allow",
          "sinfo *": "allow",
          "module list*": "allow",
          "module avail*": "allow",
          "module spider*": "allow",
          "which *": "allow",
          "python --version": "allow",
          "python -V": "allow",
          "python -m pip show *": "allow",
          "nvcc --version": "allow",
          "nvidia-smi*": "allow",
          "pwd": "allow",
          "ls *": "allow",
          "cat *": "ask",
          "head *": "allow",
          "tail *": "allow",
          "grep *": "allow",

          "rm *": "deny",
          "mv *": "deny",
          "cp *": "deny",
          "mkdir *": "deny",
          "touch *": "deny",
          "chmod *": "deny",
          "chown *": "deny",
          "sbatch *": "deny",
          "srun *": "deny",
          "salloc *": "deny",
          "scancel *": "deny",
          "pip install *": "deny",
          "python -m pip install *": "deny",
          "conda install *": "deny",
          "mamba install *": "deny",
          "git push *": "deny",
          "git reset *": "deny",
          "git clean *": "deny",
          "* > *": "deny",
          "* >> *": "deny",
          "tee *": "deny",
          "sed -i *": "deny",
          "nano *": "deny",
          "vim *": "deny",
          "emacs *": "deny",

          "*": "ask"
        }
      }
    }
  },
  "provider": {
    "ncsahosted": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NCSA Hosted",
      "options": {
        "baseURL": "{env:NCSA_LLM_URL}"
      },
      "models": {
        "Qwen/Qwen3.6-27B": {
          "name": "Qwen3.6-27B",
          "options": {
            "stream": true
          }
        }
      }
    }
  },
  "mcp": {
    "slurm-mcp-server": {
      "type": "remote",
      "url": "http://dt-hpcgpt:8001/mcp",
      "enabled": true
    },
    "illinois-chat-server": {
      "type": "remote", 
      "url": "http://dt-hpcgpt:8002/mcp",
      "enabled": true
    },
    "report-server": {
      "type": "remote",
      "url": "http://dt-hpcgpt:8003/mcp", 
      "enabled": true
    },
    "knowledge-base-server": {
      "type": "remote",
      "url": "http://dt-hpcgpt:8004/mcp",
      "enabled": true
    }
  },
  "command": {
    "report": {
      // Description shown in the TUI
      "template": "{file:./prompts/report.txt}",
      "description": "Report an issue to the Delta support team",
      "agent": "support",
      "model": "ncsahosted/Qwen/Qwen3.6-27B"
    }
  },
  // I'm disabling sharing as i don't think this is a feature we want on Delta
  "share": "disabled",
  // Configure permissions to control what AI agents can do by default.
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
