{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": false,
    "enabled_providers": ["ncsahosted", "lumen"],
    "default_agent": "learning",
    "agent": {
      "build": { "disable": true },
      "plan": { "disable": true },
    },
    "mode": {
      "learning": {
        "model": "lumen/qwen3.8-27b",
        "prompt": "{file:./prompts/learning.txt}",
        "tools": {
          "read": true,
          "list": true,
          "glob": true,
          "grep": true,
          "write": true,
          "edit": true,
          "bash": true
        },
        "permission": {
          "read": "allow",
          "list": "allow",
          "glob": "allow",
          "grep": "allow",
          "edit": "ask",
          "bash": {
            "*": "ask",
            "pwd": "allow",
            "ls *": "allow",
            "find *": "allow",
            "grep *": "allow",
            "make -n*": "allow",
            "bash -n *": "allow",
            "git status*": "allow",
            "git diff*": "allow",
            "rm *": "deny",
            "rm -r *": "deny",
            "rm -rf *": "deny",
            "sbatch *": "ask",
            "srun *": "ask",
            "salloc *": "ask",
            "scancel *": "ask"
          },
          "task": "deny",
          "external_directory": "ask"
        }
      },
      "debug": {
        "model": "lumen/qwen3.8-27b",
        "prompt": "{file:./prompts/debug.txt}",
        "tools": {
          "read": true,
          "list": true,
          "glob": true,
          "grep": true,
          "write": true,
          "edit": true,
          "bash": true
        },
        "permission": {
          "read": "allow",
          "list": "allow",
          "glob": "allow",
          "grep": "allow",
          "edit": "ask",
          "bash": "ask"
        }
      }
    },
    "provider": {
      "ncsahosted": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "NCSA DGX",
        "options": {
          "baseURL": "{env:NCSA_LLM_URL}"
        },
        "models": {
          "Qwen/Qwen3.6-27B": {
            "name": "Qwen 3.6 27B",
            "options": {
              "stream": true
            }
          }
        }
      },
      "lumen": {
        "npm": "@ai-sdk/openai-compatible",
        "name": "NCSA Lumen",
        "options": {
          "baseURL": "https://lumen.ncsa.illinois.edu/v1",
          "apiKey": "{file:./lumen.txt}"
        },
        "models": {
          "deepseek-v4-flash": {
            "name": "deepseek-v4-flash",
            "limit": {
              "context": 511994,
              "output": 128000
            },
            "cost": {
              "input": 0.161857,
              "output": 0.37146
            }
          },
          "gemma-4-31b": {
            "name": "gemma-4-31b",
            "limit": {
              "context": 46790,
              "output": 32768
            },
            "cost": {
              "input": 0.167931,
              "output": 0.436103
            }
          },
          "glm-5.3": {
            "name": "glm-5.3",
            "limit": {
              "context": 524282,
              "output": 131072
            },
            "cost": {
              "input": 1.321413,
              "output": 4.248318
            }
          },
          "muse-glimmer-30b": {
            "name": "muse-glimmer-30b",
            "limit": {
              "context": 131066,
              "output": 131072
            },
            "cost": {
              "input": 0.322727,
              "output": 1.345455
            }
          },
          "nemotron-3-super-120b": {
            "name": "nemotron-3-super-120b",
            "limit": {
              "context": 262144,
              "output": 262144
            },
            "cost": {
              "input": 0.168636,
              "output": 0.759091
            }
          },
          "ornith-1.0-35b": {
            "name": "ornith-1.0-35b",
            "limit": {
              "context": 262138,
              "output": 256000
            },
            "cost": {
              "input": 0.05,
              "output": 0.1
            }
          },
          "qwen3-coder-next": {
            "name": "qwen3-coder-next",
            "limit": {
              "context": 131066,
              "output": 256000
            },
            "cost": {
              "input": 0.226538,
              "output": 1.235846
            }
          },
          "qwen3.6-35b": {
            "name": "qwen3.6-35b",
            "limit": {
              "context": 262138,
              "output": 131056
            },
            "cost": {
              "input": 0.185435,
              "output": 1.138217
            }
          },
          "qwen3.8-27b": {
            "name": "qwen3.8-27b",
            "limit": {
              "context": 250542,
              "output": 262144
            },
            "cost": {
              "input": 0.364571,
              "output": 2.3965
            }
          },
          "qwen3.8-flash": {
            "name": "qwen3.8-flash",
            "limit": {
              "context": 262138,
              "output": 131072
            },
            "cost": {
              "input": 0.142798,
              "output": 0.452902
            }
          }
        }
      }
    },
    "mcp": {
      "slurm-mcp-server": {
        "type": "remote",
        "url": "http://dt-hpcgpt:8001/mcp",
        "enabled": true
      },
      "illinois-chat-server": {
        "type": "remote", 
        "url": "http://dt-hpcgpt:8002/mcp",
        "enabled": true
      },
      "report-server": {
        "type": "remote",
        "url": "http://dt-hpcgpt:8003/mcp", 
        "enabled": true
      },
      "knowledge-base-server": {
        "type": "remote",
        "url": "http://dt-hpcgpt:8004/mcp",
        "enabled": true
      }
    },
    "command": {
      "report": {
        // Description shown in the TUI
        "template": "{file:./prompts/report.txt}",
        "description": "Report an issue to the Delta support team",
        "agent": "support",
        "model": "lumen/qwen3.8-27b"
      }
    },
    // I'm disabling sharing as i don't think this is a feature we want on Delta
    "share": "disabled",
    // Configure permissions to control what AI agents can do by default.
    "permission": {
      "edit": "ask",
      "bash": "ask"
    }
  }
  