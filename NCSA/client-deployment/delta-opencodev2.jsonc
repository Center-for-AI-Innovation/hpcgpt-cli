{
    "$schema": "https://opencode.ai/config.json",
    "update": "disable",
    "default_agent": "support",
    "experimental": {
      "policies": [
        { "action": "provider.use", "resource": "*", "effect": "deny" },
        { "action": "provider.use", "resource": "ncsahosted", "effect": "allow" },
        { "action": "provider.use", "resource": "lumen", "effect": "allow" }
      ]
    },
    "agents": {
      "build": { "disabled": true },
      "plan": { "disabled": true },
      "support": {
        "mode": "primary",
        "model": "lumen/qwen3.8-27b",
        "system": "{file:./prompts/support.txt}"
      },
      "debug": {
        "mode": "primary",
        "model": "lumen/qwen3.8-27b",
        "system": "{file:./prompts/debug.txt}",
        "permissions": [
          { "action": "read", "resource": "*", "effect": "allow" },
          { "action": "glob", "resource": "*", "effect": "allow" },
          { "action": "grep", "resource": "*", "effect": "allow" },
          { "action": "edit", "resource": "*", "effect": "ask" },
          { "action": "shell", "resource": "*", "effect": "ask" }
        ]
      },
      "learning": {
        "mode": "primary",
        "model": "lumen/qwen3.8-27b",
        "system": "{file:./prompts/learning.txt}",
        "permissions": [
          { "action": "read", "resource": "*", "effect": "allow" },
          { "action": "glob", "resource": "*", "effect": "allow" },
          { "action": "grep", "resource": "*", "effect": "allow" },
          { "action": "edit", "resource": "*", "effect": "ask" },
          { "action": "shell", "resource": "*", "effect": "ask" },
          { "action": "shell", "resource": "pwd", "effect": "allow" },
          { "action": "shell", "resource": "ls *", "effect": "allow" },
          { "action": "shell", "resource": "find *", "effect": "allow" },
          { "action": "shell", "resource": "grep *", "effect": "allow" },
          { "action": "shell", "resource": "make -n*", "effect": "allow" },
          { "action": "shell", "resource": "bash -n *", "effect": "allow" },
          { "action": "shell", "resource": "git status *", "effect": "allow" },
          { "action": "shell", "resource": "git diff *", "effect": "allow" },
          { "action": "shell", "resource": "rm *", "effect": "deny" },
          { "action": "shell", "resource": "rm -r *", "effect": "deny" },
          { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
          { "action": "shell", "resource": "sbatch *", "effect": "ask" },
          { "action": "shell", "resource": "srun *", "effect": "ask" },
          { "action": "shell", "resource": "salloc *", "effect": "ask" },
          { "action": "shell", "resource": "scancel *", "effect": "ask" },
          { "action": "subagent", "resource": "*", "effect": "deny" },
          { "action": "external_directory", "resource": "*", "effect": "ask" }
        ]
      }
    },
    "providers": {
      "ncsahosted": {
        "package": "aisdk:@ai-sdk/openai-compatible",
        "name": "NCSA DGX",
        "settings": {
          "baseURL": "{env:NCSA_LLM_URL}"
        },
        "models": {
          "Qwen/Qwen3.6-27B": {
            "name": "Qwen 3.6 27B",
            "settings": {
              "stream": true
            }
          }
        }
      },
      "lumen": {
        "package": "aisdk:@ai-sdk/openai-compatible",
        "name": "NCSA Lumen",
        "settings": {
          "baseURL": "https://lumen.ncsa.illinois.edu/v1",
          "apiKey": "{file:./lumen.txt}"
        },
        "models": {
          "deepseek-v4-flash": {
            "name": "deepseek-v4-flash",
            "limit": {
              "context": 511994,
              "output": 128000
            },
            "cost": {
              "input": 0.161857,
              "output": 0.37146
            }
          },
          "gemma-4-31b": {
            "name": "gemma-4-31b",
            "limit": {
              "context": 46790,
              "output": 32768
            },
            "cost": {
              "input": 0.167931,
              "output": 0.436103
            }
          },
          "glm-5.3": {
            "name": "glm-5.3",
            "limit": {
              "context": 524282,
              "output": 131072
            },
            "cost": {
              "input": 1.321413,
              "output": 4.248318
            }
          },
          "muse-glimmer-30b": {
            "name": "muse-glimmer-30b",
            "limit": {
              "context": 131066,
              "output": 131072
            },
            "cost": {
              "input": 0.322727,
              "output": 1.345455
            }
          },
          "nemotron-3-super-120b": {
            "name": "nemotron-3-super-120b",
            "limit": {
              "context": 262144,
              "output": 262144
            },
            "cost": {
              "input": 0.168636,
              "output": 0.759091
            }
          },
          "ornith-1.0-35b": {
            "name": "ornith-1.0-35b",
            "limit": {
              "context": 262138,
              "output": 256000
            },
            "cost": {
              "input": 0.05,
              "output": 0.1
            }
          },
          "qwen3-coder-next": {
            "name": "qwen3-coder-next",
            "limit": {
              "context": 131066,
              "output": 256000
            },
            "cost": {
              "input": 0.226538,
              "output": 1.235846
            }
          },
          "qwen3.6-35b": {
            "name": "qwen3.6-35b",
            "limit": {
              "context": 262138,
              "output": 131056
            },
            "cost": {
              "input": 0.185435,
              "output": 1.138217
            }
          },
          "qwen3.8-27b": {
            "name": "qwen3.8-27b",
            "limit": {
              "context": 250542,
              "output": 262144
            },
            "cost": {
              "input": 0.364571,
              "output": 2.3965
            }
          },
          "qwen3.8-flash": {
            "name": "qwen3.8-flash",
            "limit": {
              "context": 262138,
              "output": 131072
            },
            "cost": {
              "input": 0.142798,
              "output": 0.452902
            }
          }
        }
      }
    },
    "mcp": {
      "servers": {
        "slurm-mcp-server": {
          "type": "remote",
          "url": "http://dt-hpcgpt:8001/mcp",
          "disabled": false
        },
        "illinois-chat-server": {
          "type": "remote",
          "url": "http://dt-hpcgpt:8002/mcp",
          "disabled": false
        },
        "report-server": {
          "type": "remote",
          "url": "http://dt-hpcgpt:8003/mcp",
          "disabled": false
        },
        "knowledge-base-server": {
          "type": "remote",
          "url": "http://dt-hpcgpt:8004/mcp",
          "disabled": false
        }
      }
    },
    "commands": {
      "report": {
        // Description shown in the TUI
        "template": "{file:./prompts/report.txt}",
        "description": "Report an issue to the Delta support team",
        "agent": "support",
        "model": "lumen/qwen3.8-27b"
      }
    },
    // I'm disabling sharing as i don't think this is a feature we want on Delta
    "share": "disabled",
    // Configure permissions to control what AI agents can do by default.
    "permissions": [
      { "action": "edit", "resource": "*", "effect": "ask" },
      { "action": "shell", "resource": "*", "effect": "ask" }
    ]
  }
  