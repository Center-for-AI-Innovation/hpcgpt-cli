# Copy to .env and adjust paths/secrets for your host.
# Used by docker-compose.yml and documented for Apptainer scripts.

COMPOSE_PROJECT_NAME=ncsa-mcp

# Image registry prefix (local builds use compose `build:`; pull uses these names)
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=ncsa
IMAGE_TAG=v0.1.0

# --- Slurm host bind mounts (Delta defaults) ---
SINFO_PATH=/usr/bin/sinfo
SQUEUE_PATH=/usr/bin/squeue
SCONTROL_PATH=/usr/bin/scontrol
ACCOUNTS_PATH=/sw/user/scripts/accounts
SLURM_CONF_DIR=/etc/slurm
MUNGE_RUN_DIR=/var/run/munge
SLURM_LIB_DIR=/usr/lib64/slurm
LIBSLURM_SO=/usr/lib64/libslurm.so.44
LIBSLURMFULL_SO=/usr/lib64/slurm/libslurmfull.so

# --- Per-service config mounts ---
# Defaults use config.docker.json. For production, copy example.config.json →
# config.json (gitignored), set host to 0.0.0.0, add secrets, and point these vars there.
SLURM_CONFIG=./slurm_server/config.docker.json
ILLINOIS_CHAT_CONFIG=./illinois_chat_server/config.json
REPORT_CONFIG=./report_server/config.json
TICKET_CONFIG=./ticket_server/config.docker.json

# Ticket knowledge-base directory on the host (must contain clustered.json or similar)
TICKET_DATA_DIR=./ticket_server/fixtures

# Optional Illinois Chat overrides (otherwise taken from mounted config.json)
# ILLINOIS_CHAT_URL=
# ILLINOIS_CHAT_API_KEY=
# ILLINOIS_CHAT_MODEL=
