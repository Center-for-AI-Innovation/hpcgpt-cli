{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "enabled_providers": ["oschosted"],
  "default_agent": "support",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true },
  },
  "mode": {
    "support": {
      "model": "oschosted/qwen35-122b-fp8",
      "prompt": "{file:./prompts/support.txt}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    },
    "debug": {
      "model": "oschosted/qwen35-122b-fp8",
      "prompt": "{file:./prompts/learning.txt}",
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": "ask"
      }
    },
    "learning": {
      "model": "oschosted/qwen35-122b-fp8",
      "prompt": "{file:./prompts/debug.txt}",
      "tools": {
        "read": true,
        "list": true,
        "glob": true,
        "grep": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "ask",
        "bash": {
          "*": "ask",
          "pwd": "allow",
          "ls *": "allow",
          "find *": "allow",
          "grep *": "allow",
          "make -n*": "allow",
          "bash -n *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "rm *": "deny",
          "rm -r *": "deny",
          "rm -rf *": "deny",
          "sbatch *": "ask",
          "srun *": "ask",
          "salloc *": "ask",
          "scancel *": "ask"
        },
        "task": "deny",
        "external_directory": "ask"
      }
    }
  },
  "provider": {
    "oschosted": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OSC Hosted",
      "options": {
        "baseURL": "https://${OSC_LLM_PROJECT}.ai-alpha.osc.edu/api",
        "apiKey": "{env:OSC_HOSTED_API_KEY}"
      },
      "models": {
        "qwen3-coder-30b": {
          "name": "Qwen 3 Coder 30B",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "qwen3.6-fp8": {
          "name": "Qwen 3.6 (FP 8)",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "qwen3.8-27b-fp8": {
          "name": "Qwen 3.8 27B (FP 8)",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "gpt-oss-120b": {
          "name": "GPT OSS 120B",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "qwen35-122b-fp8": {
          "name": "Qwen 3.5 122B (FP8)",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "options": {
            "stream": true
          },
        },
        "qwen3-coder-next": {
          "name": "Qwen 3 Coder Next",
          "options": {
            "stream": true
          },
          "limit": {
            "context": 40960,
            "output": 8192
          }
        }
      }
    }
  },
  "mcp": {
    "slurm-mcp-server": {
      "type": "local",
      "command": [
        "{env:HPCGPT_ROOT}/mcp_servers/slurm_server/.venv/bin/python",
        "{env:HPCGPT_ROOT}/mcp_servers/slurm_server/server.py",
        "-c",
        "{env:HPCGPT_ROOT}/mcp_servers/slurm_server/config.json"
      ],
      "enabled": true
    },
    "osc-chat-server": {
      "type": "remote",
      "url": "{env:OSC_CHAT_MCP}",
      "headers": {
        "x-osc-user": "{env:USER}",
        "x-osc-group": "{env:OSC_LLM_PROJECT}",
      },
      "enabled": true
    }
    "splunk-mcp-server": {
      "type": "local",
      "command": [
        "{env:HPCGPT_ROOT}/mcp_servers/splunk_server/.venv/bin/python",
        "{env:HPCGPT_ROOT}/mcp_servers/splunk_server/server.py",
        "-c",
        "{env:HPCGPT_ROOT}/mcp_servers/splunk_server/config.json"
      ],
      "enabled": true,
      "environment": {
        "SPLUNK_TOKEN": "{env:SPLUNK_TOKEN}"
      }
    },
  },
  "command": {
  },
  "share": "disabled",
  "disabled_providers": ["opencode", "openai"],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  }
}
